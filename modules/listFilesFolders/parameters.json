[
  {
    "name": "parent",
    "label": "Parent Folder",
    "type": "folder",
    "help": "Parent folder to list files from.",
    "required": false,
    "options": {
      "store": "rpc://listFolders",
      "ids": true,
      "showRoot": false
    }
  },
  {
    "name": "type",
    "type": "select",
    "label": "File or Folder",
    "help": "If skipped, returns both files and folders. If set, returns only specified: folders or files.",
    "options": [
      {
        "label": "File",
        "value": "file"
      },
      {
        "label": "Folder",
        "value": "folder"
      }
    ]
  },
  {
    "name": "limit",
    "type": "uinteger",
    "label": "Limit",
    "default": 10,
    "help": "Maximum number of returned results (bundles)."
  }
]
