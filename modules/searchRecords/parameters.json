[
  {
    "name": "recordType",
    "label": "Record Type",
    "type": "select",
    "help": "Type of the record to retrieve, e.g., movie.",
    "required": true,
    "options": {
      "store": "rpc://listRecordTypes?filter=searchable",
      "nested": [
        {
          "name": "search",
          "type": "filter",
          "label": "Search criteria",
          "options": {
            "store": "rpc://listRecordTypekeys",
            "operators": [
              {
                "label": "Text",
                "options": [
                  {
                    "label": "Ends with",
                    "value": "endsWith"
                  },
                  {
                    "label": "Starts with",
                    "value": "startsWith"
                  },
                  {
                    "label": "Contains",
                    "value": "contains"
                  },
                  {
                    "label": "Equals to",
                    "value": "equalsTo"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  },
  {
    "name": "limit",
    "type": "uinteger",
    "label": "Limit",
    "default": 10,
    "help": "Maximum number of returned results (bundles)."
  }
]
