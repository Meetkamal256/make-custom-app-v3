{
  "url": "/{{parameters.recordType}}/query",
  "method": "POST",
  "headers": {},
  "response": {
    "type": "json",
    "iterate": "{{body.records}}",
    "output": {
      "label": "{{item.name}}",
      "value": "{{item.id}}"
    },
    "limit": 300
  },
  "pagination": {
    "condition": "{{(pagination.page - 1) * 5 < 300 && body.totalRecordsReturned > (pagination.page - 1) * 5}}",
    "qs": {
      "offset": "{{(pagination.page - 1) * 5}}"
    }
  }
}